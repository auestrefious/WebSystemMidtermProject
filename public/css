body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f8;
    color: #222;
    margin: 0;
    padding: 30px;
}

.container {
    max-width: 1100px;
    margin: auto;
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.1);
}

h1 {
    color: #1f2937;
    margin-top: 0;
}

.back-button {
    display: inline-block;
    margin-bottom: 20px;
    padding: 10px 16px;
    background-color: #6b7280;
    color: white;
    text-decoration: none;
    border-radius: 6px;
}

.back-button:hover {
    background-color: #4b5563;
}

.button {
    display: inline-block;
    padding: 10px 16px;
    background-color: #2563eb;
    color: white;
    text-decoration: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

.button:hover {
    background-color: #1d4ed8;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    background-color: white;
}

th,
td {
    border: 1px solid #ddd;
    padding: 12px;
    text-align: left;
}

th {
    background-color: #2563eb;
    color: white;
}

tr:nth-child(even) {
    background-color: #f9fafb;
}

input {
    width: 100%;
    max-width: 400px;
    padding: 10px;
    margin-top: 5px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

button {
    padding: 10px 16px;
    background-color: #16a34a;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

button:hover {
    background-color: #15803d;
}
/* =========================
   Simple Dashboard Design
========================= */

.dashboard-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 25px;
}

.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: 1px solid #d1d5db;
}

.dashboard-label {
    margin: 0 0 5px;
    color: #6b7280;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

.dashboard-header h1 {
    margin: 0;
    color: #111827;
    font-size: 30px;
}

.welcome-text {
    margin: 8px 0 0;
    color: #6b7280;
}

.welcome-text strong {
    color: #111827;
}

/* Logout */
.logout-form {
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    box-shadow: none;
}

.logout-button {
    padding: 9px 15px;
    background-color: #6b7280;
    color: white;
    border-radius: 5px;
    font-weight: normal;
}

.logout-button:hover {
    background-color: #4b5563;
}

/* Section title */
.dashboard-container h2 {
    margin-top: 28px;
    margin-bottom: 15px;
    color: #374151;
    font-size: 21px;
}

/* Management cards */
.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.dashboard-card {
    display: block;
    min-height: 190px;
    padding: 20px;
    border: 1px solid #d1d5db;
    border-top: 4px solid #2563eb;
    border-radius: 5px;
    background-color: #ffffff;
    color: #374151;
}

.dashboard-card:hover {
    background-color: #f9fafb;
    color: #374151;
    text-decoration: none;
}

.dashboard-card h3 {
    margin: 0 0 12px;
    color: #1f2937;
    font-size: 18px;
}

.dashboard-card p {
    min-height: 45px;
    margin-bottom: 18px;
    color: #6b7280;
    line-height: 1.5;
}

.dashboard-card span {
    color: #2563eb;
    font-size: 14px;
    font-weight: bold;
}

/* Different colored card borders */
.staff-card {
    border-top-color: #2563eb;
}

.customer-card {
    border-top-color: #16a34a;
}

.product-card {
    border-top-color: #d97706;
}

/* Make the icons simple and smaller */
.card-icon {
    display: block;
    width: auto;
    height: auto;
    margin-bottom: 15px;
    background: none;
    font-size: 24px;
}

/* Mobile layout */
@media (max-width: 800px) {
    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 15px;
    }

    .logout-form {
        width: auto;
    }
}